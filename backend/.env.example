# Copy to backend/.env and fill in. Never commit the filled-in file.

# development | production. `production` arms the fail-fast config checks.
ENVIRONMENT=development

# --- LLM provider ---------------------------------------------------------
# OpenRouter key. Your pull request diffs are sent here for analysis, so set
# your OpenRouter account's data policy to disable prompt logging and training.
OPENROUTER_API_KEY=
# Optional overrides
# LLM_MODEL=deepseek/deepseek-chat-v3-0324
# LLM_TIMEOUT_SECONDS=120

# --- GitHub OAuth App -----------------------------------------------------
# github.com > Settings > Developer settings > OAuth Apps.
# The callback URL must be exactly $BACKEND_URL/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional. Default "read:user repo". `repo` is the only classic scope that can
# list and diff private repositories; use "read:user public_repo" if you only
# ever review public ones.
# GITHUB_OAUTH_SCOPES=read:user repo

# --- Secrets --------------------------------------------------------------
# 32+ random characters. Signs session JWTs only.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Encrypts stored GitHub tokens. Separate from SESSION_SECRET on purpose:
# rotating a leaked signing key must not make every stored token undecryptable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Set only during a key rotation, then run: python -m app.scripts.reencrypt_tokens
# TOKEN_ENCRYPTION_KEY_OLD=

# --- URLs and CORS --------------------------------------------------------
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:8000
# Comma-separated exact origins. Never "*" while credentials are allowed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cross-site (Vercel -> Render) needs none+true. Same-host HTTP dev needs lax+false.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168

# --- Database -------------------------------------------------------------
# Set DATABASE_URL in production. SQLite on a container filesystem is erased on
# every deploy, taking users, tokens and stored reviews with it.
# DATABASE_URL=postgresql://user:password@host:5432/codearmor
# DATABASE_PATH=app_data.db

# --- Limits ---------------------------------------------------------------
# REVIEW_RATE_LIMIT_PER_HOUR=20
# CHAT_RATE_LIMIT_PER_HOUR=60
# MAX_DIFF_CHARS=60000
# AGENT_DIFF_CHARS=24000
# LOG_LEVEL=INFO
