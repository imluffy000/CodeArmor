# --- secrets --------------------------------------------------------------
.env
.env.local
.env.*.local
.env.production
!.env.example

# --- databases: never commit one -----------------------------------------
# A committed SQLite file shipped encrypted OAuth tokens to a public repo once.
# Note that these rules do NOT untrack a file git is already tracking; that
# needs `git rm --cached`.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
**/venv/
**/.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- node -----------------------------------------------------------------
node_modules/

# --- build output ---------------------------------------------------------
dist/
build/
.vite/
coverage/

# --- editors and OS -------------------------------------------------------
.vscode/
.idea/
.DS_Store
*.log
